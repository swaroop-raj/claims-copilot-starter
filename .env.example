# App
APP_ENV=local
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=30

# Database
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/claims_copilot
DATABASE_URL_READONLY=postgresql://app:app@localhost:5432/claims_copilot

# Portkey / model gateway
PORTKEY_API_KEY=your-portkey-api-key
PORTKEY_VIRTUAL_KEY=your-portkey-virtual-key
PORTKEY_BASE_URL=https://api.portkey.ai/v1
OPENAI_MODEL=gpt-5
EMBEDDING_MODEL=text-embedding-3-large
MODEL_TEMPERATURE=0.1

# Security / retrieval thresholds
RETRIEVAL_SCORE_THRESHOLD=0.75
INJECTION_SCORE_THRESHOLD=0.70
ENABLE_HITL=true
